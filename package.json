{
  "name": "spoken-to-text-pipeline",
  "version": "1.0.0",
  "description": "A Node.js CLI tool that automates the transformation of spoken audio into structured, editable text through transcription and controlled post-processing stages.",
  "homepage": "https://github.com/sidec15/spoken-to-text-pipeline",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidec15/spoken-to-text-pipeline.git"
  },
  "keywords": [
    "audio",
    "speech-to-text",
    "transcription",
    "asr",
    "whisper",
    "pipeline",
    "automation",
    "cli",
    "nodejs",
    "text-processing",
    "editorial",
    "markdown",
    "batch-processing",
    "workflow"
  ],
  "license": "ISC",
  "author": "sidec15",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "spoken-to-text": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "format": "prettier --write .",
    "build": "tsc",
    "bundle": "npm run build && esbuild dist/cli.js --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs",
    "package": "npm run bundle && pkg dist/bundle.cjs --no-bytecode --public --targets node22-linux-x64,node22-macos-x64,node22-macos-arm64,node22-win-x64 --output bin/spoken-to-text",
    "package:win": "npm run bundle && pkg dist/bundle.cjs --no-bytecode --public --targets node22-win-x64 --output bin/spoken-to-text",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rimraf dist bin",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --passWithNoTests",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --maxWorkers=2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/cli-progress": "^3.11.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.9",
    "@yao-pkg/pkg": "^6.14.1",
    "esbuild": "^0.27.4",
    "jest": "^30.2.0",
    "prettier": "^3.8.0",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "openai": "^6.16.0",
    "undici": "^7.0.0",
    "winston": "^3.19.0"
  }
}
